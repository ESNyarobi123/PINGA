APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Optional: restore WordPress MySQL dump and point here for `php artisan import:legacy-wp-users`
# LEGACY_WP_DB_HOST=127.0.0.1
# LEGACY_WP_DB_PORT=3306
# LEGACY_WP_DB_DATABASE=winga_legacy
# LEGACY_WP_DB_USERNAME=root
# LEGACY_WP_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Rimoja: weka nenosiri refu, fungua /create-storage-link.php?token=... kisha futa thamani hii na faili hiyo kwenye production
STORAGE_LINK_TOKEN=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Snippe payments (subscriptions, wallet deposits, payouts)
SNIPPE_API_KEY=
SNIPPE_URL=https://api.snippe.sh
# Base URL Snippe uses to reach /api/webhooks/snippe (must be publicly reachable HTTPS)
SNIPPE_WEBHOOK_BASE_URL=https://your-domain.example
# Required in production: HMAC secret from Snippe Dashboard -> Settings -> Webhooks
SNIPPE_WEBHOOK_SECRET=

# Selcom payouts (optional fallback)
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=WINGA
SELCOM_BASE_URL=https://apigw.selcommobile.com/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
